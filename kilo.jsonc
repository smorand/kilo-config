{
  "$schema": "https://app.kilo.ai/config.json",
  "permission": {
    "external_directory": {
      "/Users/sebastien/Documents/Projects/misc/mayou8/*": "allow",
      "/Users/sebastien/.claude/*": "allow"
    }
  },
  "provider": {
    "mlx": {
      "name": "MLX Local",
      "api": "openai",
      "options": {
        "baseURL": "http://localhost:9121/v1",
        "apiKey": "mlx-local"
      },
      "models": {
        "qwen3.6-27b-4bit": {
          "id": "mlx-community/Qwen3.6-27B-4bit",
          "name": "Qwen 3.6 27B (4-bit)",
          "attachment": false,
          "reasoning": true,
          "temperature": true,
          "tool_call": true,
          "limit": {
            "context": 256000,
            "output": 8192
          },
          "modalities": {
            "input": ["text"],
            "output": ["text"]
          }
        }
      }
    }
  }
}